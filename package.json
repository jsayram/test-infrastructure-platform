{
  "name": "test-infrastructure-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "test": "node --test apps/api/app.test.js tests/playwright/history.test.mjs",
    "lint": "eslint apps/api apps/web scripts/smoke.mjs tests/playwright tests/ai-evals tests/mobile/run.mjs eslint.config.js",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test --config=tests/playwright/playwright.config.js",
    "test:e2e:report": "node tests/playwright/history.mjs",
    "test:mobile": "node tests/mobile/run.mjs",
    "test:ai": "node tests/ai-evals/workflow.mjs"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  }
}
